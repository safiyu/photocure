[Unit]
Description=Photocure photo curation service
After=network-online.target
Wants=network-online.target
Documentation=https://github.com/safiyu/photocure

[Service]
Type=notify
ExecStart=/usr/bin/photocure serve --no-open
Restart=on-failure
RestartSec=5s
StartLimitBurst=5
StartLimitIntervalSec=60s
Environment=PYTHONUNBUFFERED=1
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
